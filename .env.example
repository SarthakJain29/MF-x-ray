# Copy to .env.local and fill in. All optional — without keys, AI chat runs in offline (on-device) mode.

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-lite-latest)
GEMINI_MODEL=

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-120b)
GROQ_MODEL=

# Which provider to try first when both keys are set: gemini | groq (the other is used as fallback)
LLM_PROVIDER=
